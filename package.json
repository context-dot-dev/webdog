{
  "name": "webdog-ai",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Open-source website change monitoring — scrape, diff, notify.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "worker:once": "tsx scripts/worker.ts --once",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:reset": "rm -f data/webdog-ai.db data/webdog-ai.db-shm data/webdog-ai.db-wal && drizzle-kit push",
    "lint": "next lint"
  },
  "dependencies": {
    "better-auth": "^1.2.7",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.45.2",
    "next": "^15.1.11",
    "node-cron": "^3.0.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
