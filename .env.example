# Copy to .env and fill in the blanks. Never commit .env.

# context.dev API key (Bearer token). Get one at https://context.dev
CONTEXT_DEV_API_KEY=

# Where SQLite lives. Relative paths are resolved from the project root.
# On Railway with a volume at /data, you can omit this — it defaults to /data/web-watchdog.db.
# On Railway (or any host with a persistent volume), use an absolute path, e.g. /data/web-watchdog.db
DATABASE_URL=./data/web-watchdog.db

# BetterAuth secret — any long random string. Generate with: openssl rand -base64 32
# On Railway, omit this to auto-create a secret on the volume at /data/.better-auth-secret (one-click template).
BETTER_AUTH_SECRET=
# On Railway, omit this to default to https://$RAILWAY_PUBLIC_DOMAIN (enable public networking first).
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra origins (e.g. http://10.0.0.5:3000) if you open the app from another host
# BETTER_AUTH_TRUSTED_ORIGINS=

# How often the worker scrapes targets (cron expression). Default: every 15 min.
SCRAPE_CRON=*/15 * * * *

# Email alerts use Resend with per-user API keys and addresses (Settings → Notification Channels).
