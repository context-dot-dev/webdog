# Copy to .env and fill in the blanks. Never commit .env.

# context.dev API key (Bearer token). Get one at https://context.dev
CONTEXT_DEV_API_KEY=

# Where SQLite lives. Relative paths are resolved from the project root.
DATABASE_URL=./data/web-watchdog.db

# BetterAuth secret — any long random string. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# How often the worker scrapes targets (cron expression). Default: every 15 min.
SCRAPE_CRON=*/15 * * * *
